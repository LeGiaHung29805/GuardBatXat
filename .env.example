SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/GuardBatXat
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_with_a_local_secret
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
INTERNAL_API_TOKEN=replace_with_a_random_service_to_service_secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_FORWARDED_HEADERS=false
SPRING_FLYWAY_ENABLED=false
BATXAT_DEMO_SEED_ENABLED=false
# Required only when BATXAT_DEMO_SEED_ENABLED=true:
BATXAT_DEMO_CITIZEN_PASSWORD=replace_with_a_demo_secret
BATXAT_DEMO_RESCUE_PASSWORD=replace_with_a_demo_secret
BATXAT_DEMO_COMMANDER_PASSWORD=replace_with_a_demo_secret
BATXAT_DEMO_ADMIN_PASSWORD=replace_with_a_demo_secret
